{
  "name": "patchproof",
  "version": "0.4.1",
  "description": "AI-style bug repair with bounded behavioral evidence certificates.",
  "keywords": [
    "bug-fix",
    "verification",
    "javascript",
    "python",
    "testing",
    "certificate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsserAl1012/patchproof.git"
  },
  "bugs": {
    "url": "https://github.com/AsserAl1012/patchproof/issues"
  },
  "homepage": "https://github.com/AsserAl1012/patchproof#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "patchproof": "bin/patchproof.js"
  },
  "exports": {
    ".": "./runtime.js",
    "./engine": "./engine.js",
    "./repository-adapter": "./repository-adapter.js",
    "./server": "./server.js"
  },
  "files": [
    ".env.example",
    "action.yml",
    "app.js",
    "bin",
    "compose.yml",
    "Dockerfile",
    "docs",
    "engine.js",
    "examples",
    "helm",
    "index.html",
    "migrations",
    "patchproof.yml",
    "python-examples.js",
    "repository-adapter.js",
    "README.md",
    "runtime.js",
    "saas",
    "sandbox",
    "scripts",
    "server.js",
    "styles.css",
    "worker.js",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node server.js",
    "serve": "node bin/patchproof.js serve",
    "runner": "node bin/patchproof.js runner",
    "migrate": "node bin/patchproof.js migrate",
    "test": "node --test",
    "check": "node scripts/check.js",
    "release:check": "node scripts/verify-release.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@babel/core": "^8.0.0",
    "@babel/parser": "^8.0.0",
    "@babel/plugin-transform-typescript": "^8.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "pg": "^8.21.0",
    "redis": "^6.0.0",
    "tar-stream": "^3.2.0"
  }
}
